# Copy to .env.local and fill in to enable the contact form.
# Without these the form falls back to opening the visitor's own mail client.
# Credentials come from https://dashboard.emailjs.com/
#
# The public key is designed to be exposed in client-side code, but keep the
# values out of git regardless — .env.local is ignored.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Google Analytics 4 — the measurement ID from Admin › Data streams › Web,
# in the form G-XXXXXXXXXX. Leave it blank and no Google script is loaded and
# no request leaves the browser, so a local `npm run dev` stays untracked.
#
# Vite inlines this at build time, so it has to be set wherever `npm run build`
# runs (locally before `npm run deploy`, or as a secret in a CI workflow) —
# setting it only in the hosting dashboard has no effect on a static site.
#
# Note: GA sets cookies and sends visitor data to Google. For visitors in the
# EU/Germany that normally requires consent before the tag loads.
VITE_GA_MEASUREMENT_ID=
